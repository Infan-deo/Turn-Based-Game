.spell-root
{
    width: 420px;

    position: absolute;

    left: 20px;
    top: 20px;
}

.header
{
    height: 90px;

    margin-bottom: 15px;

    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;

    justify-content: center;
    align-items: center;

    background-color: rgba(20,20,35,0.95);

    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;

    border-top-color: rgb(205,170,80);
    border-bottom-color: rgb(205,170,80);
    border-left-color: rgb(205,170,80);
    border-right-color: rgb(205,170,80);
}

.header-title
{
    font-size: 28px;
    color: white;
    -unity-font-style: bold;
}

.header-subtitle
{
    font-size: 13px;
    color: rgb(180,180,180);
}

.spell-scroll
{
    flex-grow: 1;
}

.spell-card
{
    flex-direction: row;

    height: 100px;

    margin-bottom: 10px;

    padding-left: 12px;
    padding-right: 12px;

    align-items: center;

    background-color: rgba(25,25,40,0.95);

    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;

    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;

    border-top-color: rgb(70,70,90);
    border-bottom-color: rgb(70,70,90);
    border-left-color: rgb(70,70,90);
    border-right-color: rgb(70,70,90);
}

.spell-card-hover
{
    background-color: rgb(40,50,75);

    border-top-color: rgb(255,215,0);
    border-bottom-color: rgb(255,215,0);
    border-left-color: rgb(255,215,0);
    border-right-color: rgb(255,215,0);
}

.spell-card-selected
{
    background-color: rgb(90,70,25);

    border-top-color: gold;
    border-bottom-color: gold;
    border-left-color: gold;
    border-right-color: gold;
}

.spell-icon-frame
{
    width: 70px;
    height: 70px;

    margin-right: 12px;

    justify-content: center;
    align-items: center;

    background-color: rgba(255,255,255,0.05);

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.spell-icon
{
    width: 56px;
    height: 56px;
}

.spell-content
{
    flex-grow: 1;
}

.spell-name
{
    font-size: 20px;

    color: white;

    -unity-font-style: bold;
}

.spell-description
{
    font-size: 12px;

    color: rgb(190,190,190);

    margin-top: 4px;
}

.spell-cost
{
    width: 70px;

    align-items: center;
    justify-content: center;
}

.cost-title
{
    font-size: 11px;

    color: rgb(255,215,0);
}

.cost-value
{
    font-size: 28px;

    color: white;

    -unity-font-style: bold;
}